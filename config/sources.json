{
  "sources": [
    {
      "id": "austin_commercial_permits",
      "name": "City of Austin Issued Construction Permits",
      "state": "TX",
      "metro": "Austin",
      "endpoint": "https://data.austintexas.gov/resource/3syk-w9eu.json",
